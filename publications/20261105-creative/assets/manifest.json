          "sha256": "71d2a425a6f39b05fb65e0a56cb17a4c16156473b60acb5ea03925b40c3f0e7f",
          "alt": "Explain what changes.. State one relevant difference. Support it with a demonstration or evidence."
        },
        {
          "path": "02-positioning/slide-05.png",
          "sha256": "8fff000e25c4415443ad483b1ac57ffe50186fcd7742e04341f5ebc8ce93a6af",

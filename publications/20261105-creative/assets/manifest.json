    {
      "id": "03-ai-proof",
      "title": "An AI claim needs a boundary.",
      "format": "carousel",
      "images": [
        {
          "path": "03-ai-proof/slide-01.png",
          "sha256": "d6e7f184f7bcb4c985ee0c4d974e089f345b879cb2fb2af635ac5130e961dfed",
          "alt": "An AI claim needs a boundary."
        },
        {
          "path": "03-ai-proof/slide-02.png",
          "sha256": "1cf0420109d717e5e7d40b41ebe6bfd7c6a5dad598494c31d6c0cd0a657d0fb0",
          "alt": "Show the actual workflow.. Describe the input, the action and the output a user will see."
        },
        {

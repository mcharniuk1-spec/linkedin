    {
      "id": "02-positioning",
      "title": "Make your positioning testable.",
      "format": "carousel",
      "images": [
        {
          "path": "02-positioning/slide-01.png",
          "sha256": "e890ac32a5a26a23ba86d88f08f1b90f069fc54ca37d1b955381c0a3b932624e",
          "alt": "Make your positioning testable."
        },
        {
          "path": "02-positioning/slide-02.png",
          "sha256": "bd8daa489bc8defee04f031a568e017283d939c22acf5b5b5f1cbf80ec9daf9f",
          "alt": "Name the team and task.. Who uses the product, and what are they trying to get done?"
        },
        {
          "path": "02-positioning/slide-03.png",
          "sha256": "4f47c4331ea6c1067450c732f20b1e17902b13a584b88d33b436e3af2cf6d84c",
          "alt": "Describe the real choice.. A spreadsheet, an internal process or another product can all be alternatives."
        },
        {

          "sha256": "0c857832de7ff4d801348bd461021cde14d9adfba5319be4471085b22893b09b",
          "alt": "Say who verifies the result.. Show the review step, escalation path or human decision where relevant."
        },
        {
          "path": "03-ai-proof/slide-04.png",
          "sha256": "06e6856b621e561e2206afd3044d35fa3bc76feeaad6b0db41397aba612bb7e3",
          "alt": "Name the limitation.. Be specific about conditions, exclusions and uncertainty."
        },

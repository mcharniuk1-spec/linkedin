{
  "$description": "Outspoken V3: Out navy, spoken silver; citron highlights and optional campaign alternatives. Color primitives remain fixed. Geometry and type values are reviewed local implementation tokens; owner artistic acceptance remains separate.",
  "palette": {
    "navy": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.08627451,
          0.15294118,
          0.37647059
        ],
        "alpha": 1
      },
      "$extensions": {
        "outspoken.hex": "#162760"
      }
    },
    "cobalt": {

        "colorSpace": "srgb",
        "components": [
          1.0,
          1.0,
          1.0
        ],
        "alpha": 1
      },
      "$extensions": {
        "outspoken.hex": "#FFFFFF"
      }
    },
    "citron": {
      "$type": "color",

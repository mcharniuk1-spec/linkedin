# Never commit a real .env, credential YAML, token, vault or state key.
# Use secure environment injection or a private file outside the checkout.
COLLECTOR_STATE_KEY_FILE=/path/outside/checkout/collector-state.key
LINKEDIN_CREDENTIALS_FILE=/path/outside/checkout/ld.yaml
LINKEDIN_REDIRECT_URI=https://your-exact-registered-callback.example/callback
# Alternative credential injection (leave unset until OAuth is configured):
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# GitHub Actions needs COLLECTOR_STATE_KEY as a repository secret and
# COLLECTOR_ENABLED=true as a repository variable after first-run preparation.
